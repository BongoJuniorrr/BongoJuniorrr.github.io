---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import profile from '../data/profile.json';
import experience from '../data/experience.json';
import education from '../data/education.json';
import awards from '../data/awards.json';
import skills from '../data/skills.json';
import { formatDate } from '../lib/utils';
---
<BaseLayout title="About" description="Research background and academic profile of Phuong Huu Vu Tran.">
  <div class="container">
    <header class="page-header"><p class="eyebrow">About</p><h1>Background</h1></header>
    <section class="about-section"><SectionHead num="01" title="Biography" /><div class="bio">{profile.bio.map((paragraph) => <p set:html={paragraph} />)}</div></section>
    <section class="about-section"><SectionHead num="02" title="Research Experience" /><div>{experience.map((item) => <article class="row"><time>{formatDate(item.start)}—Present</time><div><h3>{item.role}</h3><p><em>{item.organization}</em> · {item.institution}</p><p class="muted">Supervisor: {item.supervisor}</p>{item.bullets.length > 0 && <ul>{item.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}</div></article>)}</div></section>
    <section class="about-section"><SectionHead num="03" title="Education" /><div>{education.map((item) => <article class="row"><time>{item.years}</time><div><h3>{item.degree}</h3><p><em>{item.school}</em></p><p class="muted">{item.details}</p></div></article>)}</div></section>
    <section class="about-section"><SectionHead num="04" title="Selected Awards" /><ul class="awards">{awards.map((award) => <li><time>{award.year}</time><div><strong>{award.title}</strong><p class="muted">{award.organization}</p></div></li>)}</ul></section>
    <section class="about-section"><SectionHead num="05" title="Technical Background" /><dl class="skills">{skills.skill_groups.filter((group) => group.category !== 'Languages').map((group) => <div><dt>{group.category}</dt><dd>{group.items.join(' · ')}</dd></div>)}</dl></section>
    <section class="about-section"><SectionHead num="06" title="Languages" /><p>Vietnamese: Native · English: IELTS Academic 6.5 · German: B1 (self-assessed)</p><p class="view-all"><a href={profile.cv} target="_blank" rel="noopener">View CV</a></p></section>
  </div>
</BaseLayout>
<style>
  .about-section { padding:2.3rem 0; border-top:1px solid var(--border); } .about-section:first-of-type { border-top:0; padding-top:0; } .bio p + p { margin-top:1rem; } .row { display:grid; grid-template-columns:9rem 1fr; gap:1.4rem; padding:1.15rem 0; border-bottom:1px solid var(--border); } time { color:var(--accent); font-size:.8rem; font-weight:700; letter-spacing:.05em; text-transform:uppercase; } h3 { font-size:1.2rem; } em { font-family:var(--font-serif); } .row p { margin-top:.2rem; } ul { padding-left:1.2rem; margin-top:.55rem; color:var(--text-muted); } li + li { margin-top:.3rem; } .awards { list-style:none; padding:0; margin:0; } .awards li { display:grid; grid-template-columns:5rem 1fr; gap:1rem; padding:.8rem 0; border-bottom:1px solid var(--border); } .awards p { margin-top:.15rem; } .skills > div { display:grid; grid-template-columns:9rem 1fr; gap:1rem; padding:.8rem 0; border-bottom:1px solid var(--border); } dt { font-family:var(--font-serif); font-weight:650; } dd { color:var(--text-muted); } @media (max-width:620px) { .row,.skills > div,.awards li { grid-template-columns:1fr; gap:.25rem; } }
</style>
