---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import publications from '../data/publications.json';

const published = publications.filter((pub) => pub.type === 'publication');
const manuscripts = publications.filter((pub) => pub.type === 'manuscript');
---

<BaseLayout title="Publications" description="Academic publications and research contributions.">
  <div class="container">
    <header class="page-header">
      <p class="eyebrow">Research</p>
      <h1>Publications</h1>
      <p class="lede">Accepted and published research, followed separately by work currently under review.</p>
    </header>

    <section class="year-group"><h2 class="year-heading"><span>Publications</span></h2>{published.map((pub) => <PublicationItem pub={pub} showYear={false} />)}</section>
    <section class="year-group manuscripts"><h2 class="year-heading"><span>Manuscripts</span></h2><p class="muted manuscript-intro">These works are under review and are not accepted publications.</p>{manuscripts.map((pub) => <PublicationItem pub={pub} showYear={false} />)}</section>
  </div>
</BaseLayout>

<style>
  .year-group { margin-bottom: 2.4rem; }
  .year-heading {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.35rem;
    font-style: italic;
    color: var(--accent);
    margin-bottom: 0.5rem;
    font-variant-numeric: tabular-nums;
  }
  .year-heading::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--border-strong), transparent);
  }
  .manuscripts { margin-top: 4rem; }
  .manuscript-intro { margin: -0.1rem 0 1rem; font-size: .94rem; }
</style>
