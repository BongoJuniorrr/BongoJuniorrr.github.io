---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import PublicationItem from '../components/PublicationItem.astro';
import Icon from '../components/Icon.astro';
import { formatDate } from '../lib/utils';
import profile from '../data/profile.json';
import research from '../data/research.json';
import publications from '../data/publications.json';
import news from '../data/news.json';
import experience from '../data/experience.json';

const selectedWork = publications.filter((work) => work.selected && work.type === 'publication');
const recent = [...news].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 4);
const homepageExperience = experience.filter((item) => item.homepage).sort((a, b) => b.start.localeCompare(a.start));
const social = profile.social.filter((item) => ['scholar', 'github', 'linkedin', 'email'].includes(item.platform));
---

<BaseLayout>
  <section class="hero page">
    <div class="hero-copy">
      <p class="eyebrow">{profile.name}</p>
      <h1>{profile.role}<br />in {profile.research_identity}</h1>
      <p class="hero-statement">{profile.short_bio}</p>
      <p class="hero-affiliation">Vietnamese-German University · PAMI Lab · RAISE Lab · Dream AI Lab</p>
      <div class="hero-links">
        {social.map((item) => <a href={item.url} target={item.platform === 'email' ? undefined : '_blank'} rel="noopener">{item.label} <span aria-hidden="true">↗</span></a>)}
        <a href={profile.cv} target="_blank" rel="noopener">CV <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <img class="hero-avatar" src="/images/avatar.png" alt={`Portrait of ${profile.name}`} width="512" height="512" />
  </section>

  <section id="research" class="section"><div class="page">
    <SectionHead num="01" title="Research" />
    <div class="pillar-grid">
      {research.pillars.map((pillar) => <article class="pillar"><p class="pillar-number">{pillar.related_work.join(' · ')}</p><h3>{pillar.title}</h3><p>{pillar.description}</p></article>)}
    </div>
    <div class="emerging"><strong>Emerging directions</strong><ul>{research.emerging_directions.map((direction) => <li>{direction}</li>)}</ul></div>
  </div></section>

  <section id="work" class="section"><div class="page">
    <SectionHead num="02" title="Selected Work" />
    <div class="work-list">{selectedWork.map((work) => <PublicationItem pub={work} />)}</div>
    <p class="view-all"><a href="/publications/">View all publications and manuscripts</a></p>
  </div></section>

  <section id="recent" class="section"><div class="page">
    <SectionHead num="03" title="Recent" />
    <ul class="recent-list">{recent.map((item) => <li><time>{formatDate(item.date)}</time><span set:html={item.text} />{item.link && <a class="recent-link" href={item.link} target="_blank" rel="noopener" aria-label="Open related item"><Icon name="external" size={14} /></a>}</li>)}</ul>
  </div></section>

  <section id="experience" class="section"><div class="page">
    <SectionHead num="04" title="Research Experience" />
    <div class="experience-list">{homepageExperience.map((item) => <article class="experience-row"><time>{formatDate(item.start)} - Present</time><div><h3>{item.role}</h3><p class="lab-line"><a href={item.lab_url} target="_blank" rel="noopener"><em>{item.organization}</em></a><span> · {item.institution}</span><a class="inline-icon" href={item.lab_url} target="_blank" rel="noopener" aria-label={`${item.organization} homepage`} title="Lab homepage"><Icon name="external" size={14} /></a></p><p class="muted supervisors">Supervisor: {item.supervisors.map((supervisor) => <span class="supervisor"><a href={supervisor.homepage ?? supervisor.scholar} target="_blank" rel="noopener">{supervisor.name}</a><a class="inline-icon" href={supervisor.scholar} target="_blank" rel="noopener" aria-label={`${supervisor.name} on Google Scholar`} title="Google Scholar"><Icon name="scholar" size={14} /></a></span>)}</p></div></article>)}</div>
    <p class="view-all"><a href="/about/">More about my background</a></p>
  </div></section>

  <section id="contact" class="section"><div class="page contact">
    <p class="eyebrow">Contact</p><h2>Research, collaboration,<br />or a good technical question.</h2>
    <p>Feel free to reach out about research collaboration, multimodal AI, reliable RAG, or related work.</p>
    <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a>
  </div></section>
</BaseLayout>

<style>
  .hero { min-height:clamp(32rem,64vh,42rem); padding:clamp(5rem,10vh,7.5rem) 0 4rem; display:grid; grid-template-columns:minmax(0, 1fr) 12.5rem; align-items:center; gap:3rem; }
  .hero h1 { max-width:690px; margin:.8rem 0 1.4rem; font-size:clamp(2.35rem,4.4vw,4rem); } .hero-statement { max-width:630px; font-size:clamp(1.05rem,2vw,1.25rem); line-height:1.55; } .hero-affiliation { margin-top:1.2rem; color:var(--text-muted); } .hero-links { display:flex; flex-wrap:wrap; gap:.55rem 1rem; margin-top:2rem; } .hero-links a { font-size:.9rem; font-weight:650; text-decoration:none; } .hero-avatar { width:13.5rem; height:auto; border-radius:4px; object-fit:contain; border:1px solid var(--border-strong); }
  .pillar-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:2rem; } .pillar { padding-top:1rem; border-top:2px solid var(--accent); } .pillar-number { min-height:1.4rem; color:var(--accent); font-size:.76rem; font-weight:700; letter-spacing:.05em; } .pillar h3 { font-size:1.45rem; margin:.4rem 0 .6rem; } .pillar p:not(.pillar-number) { color:var(--text-muted); font-size:.95rem; } .emerging { margin-top:2.3rem; padding-top:1rem; border-top:1px solid var(--border); color:var(--text-muted); } .emerging ul { display:grid; gap:.25rem; list-style:none; margin-top:.45rem; } .emerging li::before { content:'- '; color:var(--accent); }
  .work-list { max-width:850px; } .recent-list { list-style:none; max-width:850px; } .recent-list li { display:grid; grid-template-columns:7rem 1fr auto; gap:1rem; padding:.85rem 0; border-bottom:1px solid var(--border); } .recent-list time,.experience-row time { color:var(--accent); font-size:.8rem; font-weight:700; letter-spacing:.06em; text-transform:uppercase; } .recent-link { line-height:0; }
  .experience-list { max-width:900px; } .experience-row { display:grid; grid-template-columns:11.4rem 1fr; gap:1.5rem; padding:1.25rem 0; border-bottom:1px solid var(--border); } .experience-row time { white-space:nowrap; } .experience-row h3 { font-size:1.22rem; } .experience-row p { margin-top:.2rem; } .experience-row em { font-family:var(--font-serif); } .lab-line,.supervisors { display:flex; align-items:center; flex-wrap:wrap; gap:.25rem; } .inline-icon { display:inline-flex; align-items:center; margin-left:.15rem; color:var(--text-faint); line-height:0; } .inline-icon:hover { color:var(--accent); } .supervisor { display:inline-flex; align-items:center; white-space:nowrap; } .supervisor + .supervisor::before { content:';'; margin-right:.25rem; color:var(--text-faint); }
  .contact { padding-bottom:2rem; } .contact h2 { margin:.7rem 0 1rem; font-size:clamp(2.3rem,4vw,4rem); } .contact > p { max-width:560px; color:var(--text-muted); } .contact-email { display:inline-block; margin-top:1.3rem; font-size:1.15rem; font-weight:650; }
  @media (max-width:760px) { .hero { min-height:unset; grid-template-columns:1fr; gap:1.6rem; } .hero-avatar { width:10rem; grid-row:1; } .pillar-grid { grid-template-columns:1fr; gap:1.5rem; } .recent-list li,.experience-row { grid-template-columns:1fr; gap:.25rem; } .recent-list time { margin-bottom:.1rem; } }
</style>
