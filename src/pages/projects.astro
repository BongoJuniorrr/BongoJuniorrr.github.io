---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';
---

<BaseLayout title="Projects" description="Engineering and research projects by Phuong Huu Vu Tran.">
  <div class="page">
    <header class="page-header">
      <p class="eyebrow">Portfolio</p>
      <h1>Engineering &amp; Research Projects</h1>
      <p class="lede">Selected systems that complement my research work.</p>
    </header>

    <section><h2 class="project-group">Selected Projects</h2><div class="project-grid">{projects.filter((p) => p.featured).map((p) => <ProjectCard project={p} />)}</div></section>
    <section class="earlier"><h2 class="project-group">Earlier Projects</h2><div class="project-grid">{projects.filter((p) => !p.featured).map((p) => <ProjectCard project={p} />)}</div></section>
  </div>
</BaseLayout>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 1.1rem;
    margin-top: 1rem;
  }
  .project-group { font-size: 1.55rem; margin-bottom: 1rem; }
  .earlier { margin-top: 3.5rem; }
</style>
