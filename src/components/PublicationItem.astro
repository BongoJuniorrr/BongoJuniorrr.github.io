---
import Icon from './Icon.astro';
import { formatAuthors } from '../lib/utils';

interface Props {
  pub: {
    title: string;
    authors: string[];
    venue: string;
    year: number;
    status?: string;
    note?: string;
    image?: string;
    links?: Record<string, string>;
    abstract?: string;
    role?: string;
    outcome?: string;
    ranking?: string;
    track?: string;
  };
  showYear?: boolean;
}
const { pub, showYear = true } = Astro.props;

const linkIcons: Record<string, string> = {
  paper: 'pdf',
  pdf: 'pdf',
  arxiv: 'arxiv',
  code: 'code',
  anthology: 'book',
};
const linkLabels: Record<string, string> = {
  paper: 'Paper',
  pdf: 'PDF',
  arxiv: 'arXiv',
  code: 'Code',
  anthology: 'ACL Anthology',
  slides: 'Slides',
  poster: 'Poster',
  video: 'Video',
};
const links = Object.entries(pub.links ?? {}).filter(([, url]) => url);
const showVenueLabels = !/review|submitted|preprint/i.test(pub.status ?? '');
const rankingKind = pub.ranking?.toLowerCase().replace('*', 'star');

// Status badge styling: award-like (gold) vs under-review (amber) vs neutral
const statusKind = pub.status
  ? /champion|best|award|winner|1st/i.test(pub.status)
    ? 'award'
    : /accept|published|camera|to appear/i.test(pub.status)
      ? 'accepted'
      : /review|submitted|preprint/i.test(pub.status)
        ? 'review'
        : 'neutral'
  : null;
---

<article class="pub reveal">
  {pub.image && (
    <div class="pub-thumb-wrap">
      <img class="pub-thumb" src={pub.image} alt={`Figure from: ${pub.title}`} loading="lazy" />
    </div>
  )}
  <div class="pub-body">
    <div class="pub-meta">
      <span class="pub-venue-badge">{pub.venue}</span>
      {showVenueLabels && pub.ranking && <span class={`venue-label venue-label--${rankingKind}`}>{pub.ranking}</span>}
      {showVenueLabels && pub.track && <span class="venue-label venue-label--track">{pub.track}</span>}
      {pub.status && <span class={`pub-status pub-status--${statusKind}`}>{pub.status}</span>}
      {showYear && <span class="pub-year">{pub.year}</span>}
    </div>
    <h3 class="pub-title">{pub.title}</h3>
    <p class="pub-authors" set:html={formatAuthors(pub.authors)} />
    {(pub.role || pub.outcome || pub.note) && <p class="pub-note">{[pub.role, pub.outcome, pub.note].filter(Boolean).join(' · ')}</p>}
    {(links.length > 0 || pub.abstract) && (
      <div class="pub-links">
        {links.map(([kind, url]) => (
          <a class="badge-link" href={url} target="_blank" rel="noopener">
            <Icon name={linkIcons[kind] ?? 'external'} size={13} />
            {linkLabels[kind] ?? kind[0].toUpperCase() + kind.slice(1)}
          </a>
        ))}
        {pub.abstract && (
          <details class="pub-abstract">
            <summary class="badge-link">Abstract</summary>
          </details>
        )}
      </div>
    )}
    {pub.abstract && <p class="pub-abstract-text" hidden>{pub.abstract}</p>}
  </div>
</article>

<style>
  .pub {
    display: flex;
    gap: 1.4rem;
    align-items: flex-start;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .pub:last-child { border-bottom: none; }

  .pub-thumb-wrap { flex: 0 0 172px; }
  .pub-thumb {
    width: 172px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-surface);
    box-shadow: var(--shadow);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .pub:hover .pub-thumb {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }
  .pub-body { flex: 1; min-width: 0; }

  .pub-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
  }
  .pub-venue-badge {
    font-size: 0.74rem;
    font-weight: 620;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    border-radius: 3px;
    padding: 0.12rem 0.65rem;
  }
  .pub-year {
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-faint);
    font-weight: 560;
  }
  .venue-label {
    border: 1px solid var(--border-strong);
    border-radius: 3px;
    color: var(--text-muted);
    font-size: .72rem;
    font-weight: 640;
    letter-spacing: .05em;
    line-height: 1.25;
    padding: .12rem .6rem;
    text-transform: uppercase;
  }
  .venue-label--astar { background: #23734f; border-color: #23734f; color: #fff; font-weight: 760; }
  .venue-label--a { background: #e4eef7; border-color: #8aafd0; color: #173f63; }
  .venue-label--q1 { background: #315f4b; border-color: #315f4b; color: #fff; }
  .venue-label--q2 { background: #e5f0ea; border-color: #94b7a2; color: #254a39; }
  .venue-label--b, .venue-label--q3 { background: var(--bg-subtle); }
  .venue-label--c, .venue-label--q4, .venue-label--unranked { opacity: .76; }
  .venue-label--track { background: #f6ead2; border-color: #d5ae6d; color: #6b4913; font-weight: 680; letter-spacing: .025em; text-transform: none; }
  :global(:root[data-theme='dark']) .venue-label--astar { background: #31835c; border-color: #31835c; color: #fff; }
  :global(:root[data-theme='dark']) .venue-label--a { background: #18334c; border-color: #527da3; color: #b8d8f3; }
  :global(:root[data-theme='dark']) .venue-label--q1 { background: #3e735b; border-color: #3e735b; }
  :global(:root[data-theme='dark']) .venue-label--q2 { background: #1f3d30; border-color: #638f76; color: #b8dec5; }
  :global(:root[data-theme='dark']) .venue-label--track { background: #3b2d18; border-color: #8e6b37; color: #ead29d; }
  .pub-status {
    font-size: 0.72rem;
    font-weight: 640;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: 3px;
    padding: 0.12rem 0.6rem;
    border: 1px solid transparent;
  }
  .pub-status--award {
    color: #9a6a00;
    background: rgba(196, 148, 0, 0.12);
    border-color: rgba(196, 148, 0, 0.4);
  }
  .pub-status--accepted {
    color: #1f7a4d;
    background: rgba(31, 122, 77, 0.1);
    border-color: rgba(31, 122, 77, 0.38);
  }
  :global(:root[data-theme='dark']) .pub-status--accepted {
    color: #5bd39a;
    background: rgba(91, 211, 154, 0.12);
    border-color: rgba(91, 211, 154, 0.32);
  }
  .pub-status--review {
    color: var(--text-muted);
    background: var(--bg-subtle);
    border-color: var(--border-strong);
  }
  .pub-status--neutral {
    color: var(--text-muted);
    background: var(--bg-subtle);
    border-color: var(--border);
  }
  :global(:root[data-theme='dark']) .pub-status--award {
    color: #f0c650;
    background: rgba(240, 198, 80, 0.12);
    border-color: rgba(240, 198, 80, 0.35);
  }
  .pub-title {
    font-size: 1.16rem;
    margin-bottom: 0.3rem;
  }
  .pub-authors {
    font-size: 0.92rem;
    color: var(--text-muted);
  }
  .pub-authors :global(strong) {
    color: var(--text);
    font-weight: 620;
  }
  .pub-authors :global(a) { color: inherit; text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent); }
  .pub-authors :global(sup) { font-size: .7em; margin-left: 1px; }
  .pub-note {
    font-size: 0.84rem;
    color: var(--accent);
    font-weight: 550;
    margin-top: 0.25rem;
  }
  .pub-links {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin-top: 0.65rem;
  }
  .pub-abstract summary {
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .pub-abstract summary::-webkit-details-marker { display: none; }
  .pub-abstract-text {
    margin-top: 0.6rem;
    font-size: 0.92rem;
    color: var(--text-muted);
    padding: 0.7rem 1rem;
    background: var(--bg-subtle);
    border-radius: 10px;
    border: 1px solid var(--border);
  }

  @media (max-width: 640px) {
    .pub { flex-direction: column; gap: 0.9rem; }
    .pub-thumb-wrap { flex: none; }
    .pub-thumb { width: 100%; max-width: 320px; }
  }
</style>

<script>
  // Toggle abstract visibility from the "Abstract" badge
  document.querySelectorAll('.pub-abstract').forEach((details) => {
    details.addEventListener('toggle', () => {
      const pub = details.closest('.pub');
      const text = pub?.querySelector('.pub-abstract-text');
      if (text) (text as HTMLElement).hidden = !(details as HTMLDetailsElement).open;
    });
  });
</script>
